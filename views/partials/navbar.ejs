<div id="header">
    <div class="header-content">
        <h1 id="header-title">Journal Portal</h1>

        <nav>
            <% if (user) { %>
                <a href="/">Homepage</a>
                <a href="/entries/new">New Entry</a>
                <a href="/entries/my-entries">My Entries</a>
                <a href="/entries">All Entries</a>
                <a href="/auth/sign-out">Logout</a>
                <% } else { %>
                    <a href="/auth/sign-up">Sign up</a>
                    <a href="/auth/sign-in">Login</a>
                    <% } %>
        </nav>
    </div>
</div>

<style>
    #header {
        background-color: #04d0fed8;
        padding: 16px 32px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    .header-content {
        display: flex;
        align-items: center;
        width: 100%;
        flex-wrap: wrap;
        gap: 12px;
    }

    #header-title {
        color: #ffffff;
        font-size: 1.5rem;
        margin: 0;
    }

    nav {
        display: flex;
        gap: 24px;
        margin-left: auto;
        flex-wrap: wrap;
    }

    nav a {
        text-decoration: none;
        color: #e2e8f0;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 6px 12px;
        border-radius: 6px;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    nav a:hover {
        background-color: #334155;
        color: #ffffff;
    }
</style>