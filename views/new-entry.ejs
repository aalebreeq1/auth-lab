<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Entry</title>
    <link rel="stylesheet" href="/css/entries.css">
    <link rel="stylesheet" href="/css/entry-form.css">
</head>

<body>
    <%- include('./partials/navbar') %>

        <main class="form-page">
            <h1 class="page-title">New Entry</h1>

            <form action="/entries" method="POST" class="entry-form">
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" id="title" name="title" required maxlength="100">
                </div>

                <div class="form-group">
                    <label for="entryBody">Entry Body</label>
                    <textarea id="entryBody" name="entryBody" maxlength="350" ></textarea>
                    <span class="char-hint">Max 350 characters</span>
                </div>

                <div class="form-group form-group-checkbox">
                    <input type="checkbox" id="isPublic" name="isPublic">
                    <label for="isPublic">Make this entry public</label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-submit">Create Entry</button>
                </div>
            </form>
        </main>
</body>

</html>