<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Entries</title>
    <link rel="stylesheet" href="/css/entries.css">
</head>
<body>
    <%- include('./partials/navbar') %>

    <main class="entries-page">
        <h1 class="page-title">All Entries</h1>

        <% if (entries.length === 0) { %>
            <p class="empty-state">No entries yet.</p>
        <% } %>

        <div class="entries-list">
            <% for (let entry of entries) { %>
                <article class="entry-card">
                    <div class="entry-header">
                        <h2 class="entry-title"><%= entry.title %></h2>
                        <span class="badge <%= entry.isPublic ? 'badge-public' : 'badge-private' %>">
                            <%= entry.isPublic ? 'Public' : 'Private' %>
                        </span>
                    </div>

                    <p class="entry-body"><%= entry.entryBody %></p>

                    <% if (entry.owner.toString() === user._id.toString()) { %>
                        <div class="entry-actions">
                            <a href="/entries/<%= entry._id %>/edit" class="btn btn-edit">Edit</a>
                            <form action="/entries/<%= entry._id %>?_method=DELETE" method="POST" class="inline-form">
                                <button type="submit" class="btn btn-delete">Delete</button>
                            </form>
                        </div>
                    <% } %>
                </article>
            <% } %>
        </div>
    </main>
</body>
</html>